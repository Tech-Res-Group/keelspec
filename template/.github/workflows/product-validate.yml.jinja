# Product-as-code gate for {{ project_name }}. Fails the PR if any artifact is
# malformed, references a missing id, if {{ output_bundle }} has drifted out of sync
# with {{ product_dir }}/, or if an acceptance criterion names a test that no longer
# exists. Run `keelspec build` locally and commit the result.
name: product-validate

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: Tech-Res-Group/keelspec@v{{ keelspec_version }}
        with:
          config: product.config.yaml
          plugin: product_hooks.py     # the 9xx traceability checks
